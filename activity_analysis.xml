<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_vertical">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Analysis Result"
        android:textSize="26sp"
        android:textStyle="bold"
        android:layout_marginBottom="20dp" />

    <TextView
        android:id="@+id/tvCharacterCount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Total characters: "
        android:textSize="18sp"
        android:padding="6dp" />

    <TextView
        android:id="@+id/tvVowelCount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Vowels: "
        android:textSize="18sp"
        android:padding="6dp" />

    <TextView
        android:id="@+id/tvRepeatedCharacters"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Repeated characters: "
        android:textSize="18sp"
        android:padding="6dp" />

    <TextView
        android:id="@+id/tvAge"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Current age: "
        android:textSize="18sp"
        android:padding="6dp" />

    <TextView
        android:id="@+id/tvDayOfBirth"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Day of birth: "
        android:textSize="18sp"
        android:padding="6dp" />

    <Button
        android:id="@+id/btnBack"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Back" />

</LinearLayout>
